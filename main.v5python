# X-Drive | VEX V5 Python | omni wheels, blue 600 RPM cartridges, 36:60 reduction
from vex import *
import math

brain = Brain()
controller = Controller(PRIMARY)

# Robot configuration code
#motor_group_5_motor_a = Motor(Ports.PORT5, GearSetting.RATIO_18_1, True) #cascade back motor
#motor_group_5_motor_b = Motor(Ports.PORT6, GearSetting.RATIO_18_1, False) #cascade front motor
#cascade = MotorGroup(motor_group_5_motor_a, motor_group_5_motor_b)
claw = DigitalOut(brain.three_wire_port.b)
inertial_11 = Inertial(Ports.PORT11)
piston = DigitalOut(brain.three_wire_port.a)

# One 36->60 gear mesh reverses rotation, so the left side is reversed here.
# Push the left stick forward on blocks; flip any wheel that fights the others.
fl = Motor(Ports.PORT1, GearSetting.RATIO_6_1, True)
fr = Motor(Ports.PORT2, GearSetting.RATIO_6_1, False)
bl = Motor(Ports.PORT3, GearSetting.RATIO_6_1, True)
br = Motor(Ports.PORT4, GearSetting.RATIO_6_1, False)
motors = [fl, fr, bl, br]

imu = Inertial(Ports.PORT11)
vert = Rotation(Ports.PORT5, False) #pls plug into port 17 or else change this number
horiz = Rotation(Ports.PORT6, False) #same for this

WHEEL_DIAMETER_IN  = 2.75      # 2.75 for the smaller omnis
GEAR_RATIO         = 60/36   # motor turns per wheel turn
CENTER_TO_WHEEL_IN = 7.0       # robot center to wheel contact: measure this
DEADBAND           = 0.05
TURN_SENSITIVITY   = 0.85
S_V = 0.0 #change both of these cuz this is basically our offset from the turning center, so measure this on the robot
S_H = 0.0 
SLEW = 1.2       # max volts gained per 10 ms loop (~0.1 s to full power)
TRACKING_WHEEL_DIAMETER_IN = 2.0   # diameter of the odom tracking wheels: measure this
IN_PER_TURN = math.pi * TRACKING_WHEEL_DIAMETER_IN   # inches rolled per tracking wheel turn

volts = [0.0, 0.0, 0.0, 0.0]   # last voltage sent to each motor

class Pose: #stores position in this class so it can update and we know exactly where it is
    def __init__(self):
        self.x = 0.0
        self.y = 0.0
        self.theta = 0.0
pose = Pose()

#---- The Odomotetry Loop: this is where the magic happens ---- (and yes I am using 4 dashes in spite of tyler & brett)

def odom_loop():                    #function runs forever in the background
    prev_v = vert.position(TURNS) * IN_PER_TURN     #starting distance of vertical wheel (in inches)
    prev_h = horiz.position(TURNS) * IN_PER_TURN    #same thing but for horizontal (inches)
    prev_t = math.radians(imu.rotation(DEGREES))    #starting heading

    while True:     #this is going like 100 times per second btw

    # ---- Read Sensors ---- (hahah I used the 4 dashes again with proper capitlization and you can't stop me >:)
        v = vert.position(TURNS) * IN_PER_TURN      #total inches rolled so far vertical
        h = horiz.position(TURNS) * IN_PER_TURN     #total inches rolled so far horizontal
        t = math.radians(imu.rotation(DEGREES)) #same ting but for heading

    # ---- How much did it change (hint, not enough) ---- (hahah try and stop me im using 4 dashes you cant cuz im evil)
        dv, dh, dt = v - prev_v, h - prev_h, t - prev_t    #changes in vertical wheel. also look at me im flexing my calc knowledge on yall
        prev_v, prev_h, prev_t = v, h, t        #save current readings so the next loop can analyze the change in THEM

    # --- Movement relative to robot --- (Im gonna do 3 dashes on this one to make whoever is actually reading this mad)
        if abs(dt) < 1e-6:        #if true, means robot didn't turn, and basically stops us from dividing by 0
            lx, ly = dh, dv     #dont turn only move horizontally and vertically
        else:
            chord = 2 * math.sin(dt / 2)    #chord formula: length = 2*radius*sin(angle/2)
            lx = chord * (dh / dt + S_H)    #dh/dt = Wheel's arc radius +S_H shifts it to the robots center radius
            ly = chord * (dv / dt +S_V)
    
    # --- Rotate robot-relative movement onto FIELD ----  (haha now look the dashes r uneven and you can do nada)
        avg = t - dt / 2 #average heading during step
        pose.x += lx * math.cos(avg) + ly * math.sin(avg) #adds this steps movement to field x
        pose.y += -lx * math.sin(avg) + ly * math.cos(avg) #same for y
        pose.theta = t

        wait(10, MSEC) #Pause 10 MS, and run it again

brain.screen.print("Are you Ready, yea you are")
imu.calibrate()
while imu.is_calibrating():
    wait(50,MSEC)
vert.reset_position()
horiz.reset_position()
Thread(odom_loop) #starts running odom_loop in the background

def stick(axis):
    x = axis.position() / 100
    return 0.0 if abs(x) < DEADBAND else x

#GUYS WE ARE ADDING A DEBUG DISPLAY IDK HOW WE DIDNT THINK OF THIS SOONER

def screenprintloop():
    while True:
        brain.screen.clear_screen()
        brain.screen.set_cursor(1, 1)
        brain.screen.print("X: %.1f Y: %.1f H: %.1f" %
                            (pose.x, pose.y,
                            math.degrees(pose.theta)))
        wait(100, MSEC)

Thread(screenprintloop) #starts running screenprintloop in background

def drive(forward, strafe, turn):
    powers = [forward + strafe + turn, forward - strafe - turn,
              forward - strafe + turn, forward + strafe - turn]
    peak = max(1.0, max(abs(p) for p in powers))  # scale together, never clip
    for i in range(4):
        target = 12.0 * powers[i] / peak
        last = 0.0 if volts[i] * target < 0 else volts[i]  # reversing: ramp from 0
        if abs(target) > abs(last):                         # only ramp speed-ups
            target = last + max(-SLEW, min(SLEW, target - last))
        volts[i] = target
        motors[i].spin(FORWARD, target, VoltageUnits.VOLT)


def move_wheels(wheel_inches, speed):
    degs = [x / (math.pi * WHEEL_DIAMETER_IN) * 360 * GEAR_RATIO for x in wheel_inches]
    longest = max(abs(d) for d in degs)
    if longest < 1:
        return
    for m, d in zip(motors, degs):
        m.set_velocity(max(1, speed * abs(d) / longest), PERCENT)  # all finish together
        m.spin_for(FORWARD, d, DEGREES, wait=False)
    # Stop if blocked, so a pinned robot doesn't sit at stall current.
    limit = brain.timer.time(SECONDS) + 1.5 * longest / (speed * 36) + 1
    while not all(m.is_done() for m in motors) and brain.timer.time(SECONDS) < limit:
        wait(10, MSEC)
    for m in motors:
        m.stop()
def clamp(value, limit):                               # Keep a number between -limit and +limit
    return max(-limit, min(limit, value))              # Smaller of (value, limit), then larger of that and -limit

def set_drive(fwd, strafe, turn):                      # Send forward, sideways, and turning power to the X-drive
    fl.spin(FORWARD, fwd + strafe + turn, PERCENT)     # Front-left wheel gets a blend of all three
    fr.spin(FORWARD, fwd - strafe - turn, PERCENT)     # Front-right wheel
    bl.spin(FORWARD, fwd - strafe + turn, PERCENT)     # Back-left wheel
    br.spin(FORWARD, fwd + strafe - turn, PERCENT)     # Back-right wheel (same mixing as driver control)

def stop_drive():                                      # Stop all four drive motors
    for m in (fl, fr, bl, br):                         # Go through each motor...
        m.stop(BRAKE)                                  # ...and brake it so the robot doesn't coast

def angle_diff(target_deg, current_deg):               # Shortest way to turn from current to target, in degrees
    return (target_deg - current_deg + 180) % 360 - 180   # Wraps the answer into -180..+180 (e.g. 350 vs 10 -> -20)


# ---------------- Drive forward / backward ----------------
def drive_straight(distance, max_speed=60, timeout=5000):  # distance in inches (negative = backward), timeout in ms
    sx, sy, st = pose.x, pose.y, pose.theta            # Remember where we started and which way we faced
    KP_DIST, KP_CROSS, KP_HEAD = 5.0, 8.0, 100.0       # Correction strengths (tune these!)
    start_time = brain.timer.time(MSEC)                # Note the time so we can give up if something goes wrong

    while brain.timer.time(MSEC) - start_time < timeout:   # Keep going until done OR out of time
        dx, dy = pose.x - sx, pose.y - sy              # How far we've moved on the field since starting
        along = dx * math.sin(st) + dy * math.cos(st)  # Progress along the intended line (forward)
        cross = dx * math.cos(st) - dy * math.sin(st)  # Drift sideways off the line (+ = drifted right)
        dist_err = distance - along                    # How much farther we still need to go
        head_err = st - pose.theta                     # How far we've rotated off the starting heading (radians)

        if abs(dist_err) < 0.5:                        # Within half an inch of the target?
            break                                      # Done - leave the loop

        fwd    = clamp(KP_DIST * dist_err, max_speed)  # Forward power: big when far, small when close, capped
        strafe = -KP_CROSS * cross                     # Drifted right -> strafe left (and vice versa)
        turn   = KP_HEAD * head_err                    # Rotated left -> turn right (and vice versa)
        set_drive(fwd, strafe, turn)                   # Send the blended power to the wheels
        wait(10, MSEC)                                 # Check again in 10 ms

    stop_drive()                                       # Stop the robot when finished (or timed out)


# ---------------- Strafe left / right ----------------
def strafe(distance, max_speed=60, timeout=5000):      # distance in inches (+ = RIGHT, - = LEFT), timeout in ms
    sx, sy, st = pose.x, pose.y, pose.theta            # Remember where we started and which way we faced
    KP_DIST, KP_CROSS, KP_HEAD = 5.0, 8.0, 100.0       # Correction strengths (tune these! strafing may need more)
    start_time = brain.timer.time(MSEC)                # Note the time so we can give up if something goes wrong

    while brain.timer.time(MSEC) - start_time < timeout:   # Keep going until done OR out of time
        dx, dy = pose.x - sx, pose.y - sy              # How far we've moved on the field since starting
        side  = dx * math.cos(st) - dy * math.sin(st)  # Progress sideways along the intended line (+ = right)
        drift = dx * math.sin(st) + dy * math.cos(st)  # Drift forward/back off the line (+ = drifted forward)
        dist_err = distance - side                     # How much farther we still need to slide
        head_err = st - pose.theta                     # How far we've rotated off the starting heading (radians)

        if abs(dist_err) < 0.5:                        # Within half an inch of the target?
            break                                      # Done - leave the loop

        strafe = clamp(KP_DIST * dist_err, max_speed)  # Sideways power: big when far, small when close, capped
        fwd    = -KP_CROSS * drift                     # Drifted forward -> back up a little (and vice versa)
        turn   = KP_HEAD * head_err                    # Rotated left -> turn right (and vice versa)
        set_drive(fwd, strafe, turn)                   # Send the blended power to the wheels
        wait(10, MSEC)                                 # Check again in 10 ms

    stop_drive()                                       # Stop the robot when finished (or timed out)


def angle_error(target, current):
    """Shortest signed error in degrees, range -180 to 180. Positive = need to turn right."""
    return (target - current + 180) % 360 - 180

def turn_to(target, max_speed=60, min_speed=8, kp=0.8, tolerance=1.0, timeout=5):
    timer = Timer()
    timer.reset()
    settled = 0

    while timer.time(SECONDS) < timeout:
        error = angle_error(target, imu.heading(DEGREES))

        if abs(error) <= tolerance:
            settled += 1
            if settled >= 5:        # in tolerance for ~50 ms, so it's actually stopped
                break
        else:
            settled = 0

        speed = kp * error
        # clamp speed, keeping enough power to overcome friction
        if abs(speed) > max_speed:
            speed = max_speed if speed > 0 else -max_speed
        elif abs(speed) < min_speed and abs(error) > tolerance:
            speed = min_speed if speed > 0 else -min_speed

        # positive speed = clockwise (same pattern as your turn_right_to)
        fl.spin(FORWARD,  speed, PERCENT)
        fr.spin(FORWARD, -speed, PERCENT)
        bl.spin(FORWARD,  speed, PERCENT)
        br.spin(FORWARD, -speed, PERCENT)

        wait(10, MSEC)

    for m in motors:
        m.stop(BRAKE)

def turn_right_to(target, speed=60):
    turn_to(target, max_speed=speed)

def turn_left_to(target, speed=60):
    turn_to(target, max_speed=speed)


